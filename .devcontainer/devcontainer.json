{
  "name": "Spring Boot + FastAPI ML Development",

  "image": "mcr.microsoft.com/devcontainers/java:21-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "gabrielbb.vscode-lombok",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "rangav.vscode-thunder-client",
        "ms-azuretools.vscode-docker"
      ],

      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-21",
            "path": "/usr/local/sdkman/candidates/java/current",
            "default": true
          }
        ],

        "python.defaultInterpreterPath": "/usr/local/bin/python3.12"
      }
    }
  },

  "forwardPorts": [
    8080,
    8000
  ],

  "portsAttributes": {
    "8080": {
      "label": "Spring Boot",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "chmod +x structura/mvnw",

  "remoteUser": "vscode"
}